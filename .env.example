# Zoho OAuth Configuration
# Copy this file to .env and fill in your actual Zoho OAuth credentials

# ============================================================================
# FRONTEND CONFIGURATION (.env in project root)
# ============================================================================

# Zoho OAuth Client ID (get from Zoho Developer Console)
REACT_APP_ZOHO_CLIENT_ID=1000.your_client_id_here

# Zoho OAuth Redirect URI (must match registered URI in Zoho Developer Console)
# Development: http://localhost:5173/auth/callback
# Production: https://your-domain.com/auth/callback
REACT_APP_ZOHO_REDIRECT_URI=http://localhost:5173/auth/callback

# ============================================================================
# BACKEND CONFIGURATION (functions/police_fir_api/.env or system env vars)
# ============================================================================

# Zoho OAuth Client ID
ZOHO_OAUTH_CLIENT_ID=1000.your_client_id_here

# Zoho OAuth Client Secret (KEEP PRIVATE - never commit to version control)
ZOHO_OAUTH_CLIENT_SECRET=your_client_secret_here

# Zoho OAuth Redirect URI (must match registered URI in Zoho Developer Console)
ZOHO_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Node environment
NODE_ENV=development

# Server port
PORT=3000

# ============================================================================
# HOW TO GET CREDENTIALS:
# ============================================================================

# 1. Go to https://api-console.zoho.com
# 2. Create a new OAuth application:
#    - Application Name: "Crime Analytics Portal" (or your app name)
#    - Client Type: Web applications
#    - Authorized Redirect URLs: 
#      - http://localhost:5173/auth/callback (for dev)
#      - https://your-domain.com/auth/callback (for production)
# 
# 3. Copy the generated:
#    - Client ID (goes in REACT_APP_ZOHO_CLIENT_ID and ZOHO_OAUTH_CLIENT_ID)
#    - Client Secret (goes in ZOHO_OAUTH_CLIENT_SECRET)
#
# 4. Update ZOHO_OAUTH_REDIRECT_URI to match your deployment URL

# ============================================================================
# SECURITY NOTES:
# ============================================================================

# ⚠️  NEVER commit .env files to version control
# ⚠️  Client Secret must be protected - only store on server
# ⚠️  Never expose Client Secret in browser/frontend
# ⚠️  Use HTTPS in production (secure cookies require it)
# ⚠️  Rotate credentials regularly
# ⚠️  Keep access tokens in HTTP-only cookies, never in localStorage
